{
  "name": "netfault",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3100",
    "build": "next build && node scripts/build-sw.mjs",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.544.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
